---
import Base from '../layouts/Base.astro';
import site from '../../content/site.json';

const embedUrl = site.calendarEmbedUrl?.trim() || '';
---

<Base title="Calendari" description="Properes activitats del CMES.">
  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <h1>Calendari</h1>
      </div>
      <p class="agenda-disclaimer">
        Aquest calendari és orientatiu i pot no incloure totes les activitats. La majoria d’avisos i canvis es
        comuniquen als socis pels canals interns del club (grups de WhatsApp de cada secció).
      </p>

      {embedUrl ? (
        <iframe
          class="calendar-embed"
          src={embedUrl}
          title="Calendari d’activitats del CMES"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      ) : null}

      <p class="agenda-note">
        Com i on apuntar-se: <a href="/participacio/">Participació a ses activitats</a>.
      </p>
    </div>
  </section>
</Base>
