---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, categoryBySlug, getPosts, postsInCategory } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category, posts: postsInCategory(posts, category.slug) },
  }));
}

const { category, posts } = Astro.props;
const current = categoryBySlug(Astro.params.category) ?? category;
---

<Base title={current.label} description={`Notícies de ${current.label} del CMES.`}>
  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <h1 class="page-title">{current.label}</h1>
        <a class="more" href="/blog/">Totes les notícies</a>
      </div>
      {posts.length ? (
        <div class="cards cards-3">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="empty">Encara no hi ha notícies en aquesta secció.</p>
      )}
    </div>
  </section>
</Base>
