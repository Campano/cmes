---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, isoDate, slugify } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const [category, slug] = post.permalink.replace(/^\/|\/$/g, '').split('/');
    return { params: { category, slug }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={post.data.title}
  description={post.data.description || post.data.title}
  image={post.imageUrl}
>
  {post.imageUrl && (
    <div class="post-hero">
      <img src={post.imageUrl} alt="" width="1400" height="780" />
    </div>
  )}
  <article class="band">
    <div class="wrap prose">
      <p class="post-meta">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        {post.data.tags.map((tag) => (
          <a href={`/${slugify(tag)}/`}>{tag}</a>
        ))}
      </p>
      <h1>{post.data.title}</h1>
      <Content />
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li><a href={`/${slugify(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    </div>
  </article>
</Base>
