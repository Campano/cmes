---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts.js';
import site from '../../content/site.json';

const intro = await getEntry('pages', '_inici');
if (!intro) throw new Error('Missing content/pages/_inici.md');
const { Content: Intro } = await render(intro);
const posts = (await getPosts()).slice(0, 6);
---

<Base description={site.tagline} image="/img/hero.jpg">
  <section class="club" aria-labelledby="club-title">
    <div class="club-photo">
      <img
        src="/img/hero.jpg"
        alt="La vall de Sóller de nit des d'un cim de la Serra de Tramuntana"
        width="1600"
        height="900"
      />
    </div>
    <div class="club-panel">
      <div class="club-brand">
        <img
          class="club-logo"
          src="/img/logo.png"
          alt="CMES, Club de Muntanya i Escalada Sóller"
          width="440"
          height="96"
        />
        <p class="hero-kicker">Serra de Tramuntana · Sóller</p>
        <p class="hero-lead">Senderisme, barranquisme, escalada i curses per muntanya.</p>
        <a class="btn btn-accent" href="/fes-te-soci/">Fes-te soci</a>
      </div>
      <div class="club-copy">
        <h2 id="club-title">El club</h2>
        <Intro />
        <a class="more" href="/el-club/">Coneix el club</a>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="news-title">
    <div class="wrap">
      <div class="band-head">
        <h2 id="news-title">Actualitat</h2>
        <a class="more" href="/noticies/">Totes les notícies</a>
      </div>
      <div class="cards cards-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</Base>
