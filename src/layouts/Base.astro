---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../../content/site.json';
import '../styles/global.css';

const {
  title,
  description = site.tagline,
  image = '/img/club.jpg',
  type = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title && title !== site.title ? `${title} · CMES` : site.title;
const metaDescription = String(description || site.tagline).trim();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image || '/img/club.jpg', Astro.site).href;
const isArticle = type === 'article';
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#141210" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/img/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <meta property="og:site_name" content="CMES" />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    {isArticle && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.querySelectorAll('.prose img, .post-hero img').forEach((img) => {
        if (img.closest('a')) return;
        const src = img.getAttribute('src');
        if (!src) return;
        const a = document.createElement('a');
        a.href = src;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.className = 'img-link';
        img.replaceWith(a);
        a.appendChild(img);
      });

      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy');
          if (!text) return;
          const label = btn.getAttribute('aria-label') || 'Copia';
          try {
            await navigator.clipboard.writeText(text);
            btn.classList.add('is-copied');
            btn.setAttribute('aria-label', 'Copiat');
            btn.disabled = true;
            setTimeout(() => {
              btn.classList.remove('is-copied');
              btn.setAttribute('aria-label', label);
              btn.disabled = false;
            }, 1500);
          } catch {
            btn.setAttribute('aria-label', 'Error');
            setTimeout(() => {
              btn.setAttribute('aria-label', label);
            }, 1500);
          }
        });
      });
    </script>
  </body>
</html>
