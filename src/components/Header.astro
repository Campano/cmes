---
import site from '../../content/site.json';
import { categories, categoryPath, newsPath } from '../lib/posts.js';

const path = Astro.url.pathname;
const on = (href: string) => path === href || (href !== '/' && path.startsWith(href));

const nav = [
  {
    label: 'Club',
    href: '/el-club/',
    children: [
      { label: 'Informació', href: '/el-club/' },
      { label: 'Local social', href: '/local-social/' },
      { label: 'Normes', href: '/calendari/' },
    ],
  },
  {
    label: 'Notícies',
    href: newsPath,
    children: [
      { label: 'Totes les notícies', href: newsPath },
      ...categories.map((c) => ({ label: c.label, href: categoryPath(c.slug) })),
    ],
  },
  { label: 'Agenda', href: '/agenda/' },
  { label: 'Contacte', href: '/contacte/' },
];
const cta = { label: 'Fes-te soci', href: '/fes-te-soci/' };
const instagram = site.social.find((s) => s.label === 'Instagram');
const dropOpen = (item: { children?: { href: string }[] }) =>
  item.children?.some((child) => on(child.href)) ?? false;
---

<a class="skip" href="#main">Salta al contingut</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      <img src="/img/logo.png" alt="CMES, Club de Muntanya i Escalada Sóller" width="220" height="48" />
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Obre el menú"
    >
      <span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Principal">
      {nav.map((item) =>
        item.children ? (
          <div class="drop">
            <a href={item.href} class="drop-trigger" aria-current={dropOpen(item) ? 'page' : undefined}>
              {item.label}
            </a>
            <ul class="drop-menu">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} aria-current={path === child.href ? 'page' : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={item.href} aria-current={on(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        )
      )}
      <a class="nav-cta" href={cta.href} aria-current={on(cta.href) ? 'page' : undefined}>{cta.label}</a>
      {instagram && (
        <a class="nav-ig" href={instagram.href} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
            />
          </svg>
        </a>
      )}
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.querySelector('.nav-toggle');
    const nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    const close = () => {
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Obre el menú');
      document.body.classList.remove('nav-open');
    };
    const open = () => {
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Tanca el menú');
      document.body.classList.add('nav-open');
    };
    btn.addEventListener('click', () => (btn.getAttribute('aria-expanded') === 'true' ? close() : open()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    matchMedia('(min-width: 1024px)').addEventListener('change', close);
  })();
</script>
